        set ProtoEventCommonResult[112] = "|cFF006B8F아쿠아|r가 결계를 해제하고 |cFF006B8F메구밍|r과 |cFF006B8F위즈|r가 폭렬을 쏜다. 다른 모험가들도 협력하여 요새의 진격을 멈춘다. 그러나 내부에 자폭 위험이 남아 있다. |cFF006B8F카즈마|r와 위즈는 마을이 폭발에 휘말리지 않도록 요새 안으로 들어간다."
        set ProtoEventDialogueFirst[112] = 0
