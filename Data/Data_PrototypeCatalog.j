        set ProtoCardEnding[932] = 1
        set ProtoCardDescription[932] = "죽을 사람을 구하러 경계를 넘었던 |cFF006B8F이치고|r가 현세로 돌아왔다. 빌린 힘으로 시작한 밤이, 자신이 지킬 |cFF80560C마을|r과 일상의 책임으로 남는다."
