        set ProtoEventRequiredCard[431] = 0
        set ProtoEventFailure[431] = ""
        set ProtoEventDialogueEnabled[431] = 1
        set ProtoEventCommonResult[431] = "그는 아버지의 지배를 거부하고 떠난다. |cFF006B8F에드|r는 |cFF006B8F그리드|r의 부하가 되는 형식을 받아들여 함께 움직인다. 이전 적과 갑자기 화해한 것이 아니라 아버지의 계획에 맞서고 각자의 사람들을 지키려는 목적이 만난 것이다. |cFF006B8F린|r과 그리드의 동행도 그 선택 속에서 달라진다."
        set ProtoEventDialogueFirst[431] = 69
        set ProtoDialogueStory[69] = "무엇이든 갖고 싶다는 탐욕 뒤에 잃고 싶지 않았던 동료들이 있었다.|n|n|cFF006B8F그리드|r · 내가 정말 잃기 싫었던 건, 그런 녀석들이었나."
        set ProtoDialogueChoices[69] = 2
        set ProtoDialogueNext[69] = 0
