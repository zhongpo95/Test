        set ProtoEventKey[460] = "pc_road_meal"
        set ProtoEventName[460] = "냄비를 올리기 전에"
        set ProtoEventHead[460] = 13
        set ProtoEventKind[460] = 1
        set ProtoEventChoices[460] = 3
        set ProtoEventAPCost[460] = 1
        set ProtoEventMainStage[460] = 0
        set ProtoEventEpilogue[460] = 0
        set ProtoEventGrade[460] = 1
        set ProtoEventStory[460] = "의뢰를 마친 미식전이 길가에 냄비를 내려놓는다. 페코린느는 식재료 바구니를 들여다보며 자기 몫을 몇 번이고 다시 세고, 콧코로는 다음 끼니에 쓸 재료를 따로 묶는다. 캬루는 잘린 재료 냄새를 따라 다가오는 적을 가리키며, 먹기 전에 자리부터 정하자고 투덜거린다."
        set ProtoEventIntro[460] = "더 모아 함께 먹을지, 다음 끼니를 준비할지, 식사 자리를 줄일지 정한다."
        set ProtoEventIcon[460] = "ReplaceableTextures\\CommandButtons\\BTNHealingWard.blp"
        set ProtoEventRequired[460] = 0
        set ProtoEventRequiredChoice[460] = 0
        set ProtoEventRequiredCard[460] = 0
        set ProtoEventFailure[460] = ""
        set ProtoBranchLabel[1840] = "페코린느와 넓은 구역의 재료를 모아 넉넉히 차린다"
        set ProtoBranchResult[1840] = "페코린느가 정성껏 준비한 음식을 나누며 미식전의 유대감을 확인한다. 따뜻한 온기 속에서 길드원들의 신뢰가 깊어진 기억을 얻는다."
        set ProtoBranchCard[1840] = 858
        set ProtoBranchCard2[1840] = 0
        set ProtoBranchGold[1840] = 0
        set ProtoBranchCost[1840] = 0
        set ProtoBranchLevel[1840] = 0
        set ProtoBranchDensity[1840] = 0
        set ProtoBranchPotions[1840] = 0
        set ProtoBranchChance[1840] = 100
        set ProtoBranchLabel[1841] = "밀봉된 재료를 구해 콧코로와 끼니를 나누어 준비한다"
        set ProtoBranchResult[1841] = "장보기 비용을 내고 밀봉 재료를 더 샀다. 콧코로와 오늘 먹을 몫과 다음 끼니를 나누어 담으며, 출발 전에 작은 준비를 빠뜨리지 않는 법을 익힌다."
