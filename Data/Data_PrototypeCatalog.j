        set ProtoEventAPCost[355] = 1
        set ProtoEventMainStage[355] = 0
        set ProtoEventEpilogue[355] = 0
        set ProtoEventGrade[355] = 1
        set ProtoEventStory[355] = "한 번의 놀이를 끝내고 코인을 정리하는데 스파클이 박수 소리를 흉내 낸다. 같은 얼굴을 따라온 손님들이 출구를 막자 갤러거가 놀이가 끝난 사람부터 밖으로 안내한다. 블랙 스완은 떠난 사람과 아직 같은 박수를 따라오는 사람의 기억을 나눠 듣는다."
        set ProtoEventIntro[355] = "당첨 뒤 모인 손님 사이에서 누구와 출구를 정리할지 고른다."
        set ProtoEventIcon[355] = "ReplaceableTextures\\CommandButtons\\BTNTome.blp"
