        set ProtoEventHead[201] = 10
        set ProtoEventKind[201] = 1
        set ProtoEventChoices[201] = 3
        set ProtoEventStory[201] = "에이딘 공원의 슬롯머신 앞에서 코인을 쥔 손님들이 다음 차례를 기다린다. 어벤츄린은 손에 남길 돈부터 정하라며 빈 기계 옆에 선다. 옆줄에서는 쏟아진 코인이 통로까지 굴러 나와 사람들이 몰리고 있다."
        set ProtoEventIntro[201] = "판돈을 정할지, 어벤츄린의 준비를 살필지, 막힌 통로를 도울지 정한다."
        set ProtoEventIcon[201] = "ReplaceableTextures\\CommandButtons\\BTNTome.blp"
