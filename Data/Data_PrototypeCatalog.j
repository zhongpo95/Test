        set ProtoEventDialogueEnabled[867] = 1
        set ProtoEventCommonResult[867] = "|cFF006B8F유스케|r는 스승의 착취를 외면하지 않고 괴도단과 함께 맞선다. 마다라메의 보물을 확보하고 |cFF865500사유리|r에 남은 어머니의 흔적을 되찾는다."
        set ProtoEventDialogueFirst[867] = 135
        set ProtoDialogueStory[135] = "누가 그렸는지 알아도 작품 앞의 감정까지 단순해지지는 않는다. |cFF006B8F유스케|r는 한동안 그림에서 눈을 떼지 못한다."
