        set ProtoEventDialogueEnabled[412] = 1
        set ProtoEventCommonResult[412] = "|cFF006B8F에드|r는 분노하지만 니나를 원래대로 되돌릴 방법은 찾지 못한다. 형제가 떠난 뒤 국가연금술사를 노리는 복수자 |cFF006B8F스카|r가 터커와 니나를 죽인다. 생체 연성에서 희망을 구하려던 만남은 돌이킬 수 없는 비극이 된다. 에드 역시 국가연금술사이기에 스카의 표적에서 벗어나 있지 않다."
        set ProtoEventDialogueFirst[412] = 56
        set ProtoDialogueStory[56] = "키메라를 살펴본 |cFF006B8F에드|r는 그 재료가 니나와 알렉산더였음을 알아챈다. 연구를 이어 갈 자격을 얻으려고 자기 딸을 희생시킨 것이다.|n|n에드 · 자격을 지키려고, 자기 딸을……."
