        set ProtoEventGrade[336] = 1
        set ProtoEventStory[336] = "다른 방문에서 준비 요령을 익힌 너를 우라하라가 알아보고 새 목록을 펼친다. 콘은 전에 채운 것과 같은 물건이면 그냥 넣자고 하지만 우류는 이번 받는 사람의 줄부터 보자고 한다. 루키아는 아직 지나지 않은 골목을 표시된 길과 섞지 말라고 한다. 전에 받은 준비를 반복하는 대신 이번과 다음에 맡을 몫을 답할 차례다."
        set ProtoEventIntro[336] = "상점에서 익힌 준비로 새 목록의 현재와 다음을 나눈다."
