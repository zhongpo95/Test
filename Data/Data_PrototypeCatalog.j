        set ProtoEventRequiredChoice[383] = 0
        set ProtoEventRequiredCard[383] = 0
        set ProtoEventFailure[383] = ""
        set ProtoBranchLabel[1532] = "“재미있는 이야기네. 그런데 지금 누구의 말이지?”"
        set ProtoBranchResult[1532] = "표정이 바뀌어도 질문은 그대로 둔다. 얼굴을 아는 것과 말을 믿는 것은 다른 일이다. 가면 너머의 답을 기다리며 다음 사건을 맞는다."
