        set ProtoEventCommonResult[839] = "|cFF006B8F히로|r는 배운 것을 지닌 채 모두가 살아 있는 시간으로 돌아간다. 이제 혼자 옳다고 정한 답을 강요하는 대신, 모두와 함께 저택의 근원에 닿으려 한다."
        set ProtoEventDialogueFirst[839] = 133
        set ProtoDialogueStory[133] = "다시 만날 얼굴들을 떠올릴수록 책장에 남은 글씨가 달리 보인다. 적대했던 사람도 도움을 남겼다."
