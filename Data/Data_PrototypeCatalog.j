        set ProtoEventRequiredCard[416] = 0
        set ProtoEventFailure[416] = ""
        set ProtoEventDialogueEnabled[416] = 1
        set ProtoEventCommonResult[416] = "믿고 의지하던 스승 역시 같은 금기와 상실을 겪은 사람이었다. 형제는 혼자만의 실패가 아니었음을 알게 되지만, 더블리스에서는 |cFF006B8F알|r의 갑옷에 혼을 붙인 방법을 노리는 새로운 상대가 움직이고 있다."
        set ProtoEventDialogueFirst[416] = 59
        set ProtoDialogueStory[59] = "형제는 어머니를 되살리려다 실패한 일을 고백한다. 이즈미는 엄격하게 꾸짖기만 하지 않는다. 자신도 죽은 아이를 되살리려 인체연성을 했다가 장기를 잃었다고 털어놓는다.|n|n|cFF006B8F에드|r · 선생님도 같은 대가를 치르셨군요."
        set ProtoDialogueChoices[59] = 2
        set ProtoDialogueNext[59] = 0
        set ProtoDialogueLabel[236] = "동행자 · 혼자 견디지 않으셔도 돼요."
        set ProtoDialogueResult[236] = "이즈미는 쉽게 위로할 수 있는 일이 아니지만 그 말을 듣겠다며 숨을 고른다."
        set ProtoDialogueLabel[237] = "동행자 · 그래도 저희를 가르쳐 주셔서 고마워요."
