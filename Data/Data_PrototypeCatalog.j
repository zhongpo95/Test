        set ProtoEventKey[286] = "ft_request_board"
        set ProtoEventName[286] = "무너진 게시판 아래"
        set ProtoEventHead[286] = 8
        set ProtoEventKind[286] = 1
        set ProtoEventChoices[286] = 3
        set ProtoEventAPCost[286] = 1
        set ProtoEventMainStage[286] = 0
        set ProtoEventEpilogue[286] = 0
        set ProtoEventGrade[286] = 1
        set ProtoEventStory[286] = "길드를 다시 정리하던 중 의뢰서와 수송 짐이 뒤섞여 있다. 나츠는 짐을 치울 테니 밖의 위험을 맡아 달라고 하고 루시는 주소부터 대조하자고 한다. 샤를은 해피가 옮길 짐의 무게와 지나갈 곳을 먼저 살핀다. 같은 마당에서 운반 길·의뢰서·수송 동선 중 무엇부터 맡을까?"
        set ProtoEventIntro[286] = "길드 마당에 흩어진 물건들 사이로 엉킨 의뢰서들이 널브러져 있다."
        set ProtoEventIcon[286] = "ReplaceableTextures\\CommandButtons\\BTNTome.blp"
        set ProtoEventRequired[286] = 0
        set ProtoEventRequiredChoice[286] = 0
        set ProtoEventRequiredCard[286] = 0
        set ProtoEventFailure[286] = ""
        set ProtoBranchLabel[1144] = "나츠와 짐을 옮길 길을 연다"
        set ProtoBranchResult[1144] = "나츠와 짐을 옮길 길을 열었다. 내 개인 사냥의 적 강함 단계가 1 늘었다. 나츠는 목재를 들기 전에 루시의 의뢰서를 다른 쪽으로 밀었고 아직 맡지 않은 수송 짐은 샤를 곁에 남겼다."
        set ProtoBranchCard[1144] = 503
