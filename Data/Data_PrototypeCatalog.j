        set ProtoEventEpilogue[81] = 0
        set ProtoEventGrade[81] = 3
        set ProtoEventStory[81] = "린을 구하러 성에 온 |cFF006B8F시로|r와 |cFF006B8F세이버|r, |cFF006B8F랜서|r는 각자의 상대를 향한다. 시로 앞을 막은 |cFF006B8F아처|r는 자신이 소년에게 유독 냉담했던 이유를 이야기하려 한다.|n|n두 사람이 쓰는 무기와 닮은 이상은 우연이 아니다. 시로는 린의 구출을 멈추지 않으면서도 자신에게 검을 겨누는 영령의 말을 들어야 한다.|n|n아처가 사람을 구하려는 이상이 어디로 이어지는지 알고 있느냐고 묻는다."
        set ProtoEventIntro[81] = "|cFF006B8F시로|r에게 냉담했던 영령이 자신의 이야기를 꺼낸다."
        set ProtoEventIcon[81] = "war3mapImported\\UI_EventThumb_Event_FUO_clash.tga"
        set ProtoEventImageAspect[81] = 1.777778
        set ProtoEventRequired[81] = 0
        set ProtoEventRequiredChoice[81] = 0
        set ProtoEventRequiredCard[81] = 0
        set ProtoEventFailure[81] = ""
        set ProtoEventDialogueEnabled[81] = 1
        set ProtoEventCommonResult[81] = "|cFF006B8F시로|r는 |cFF006B8F아처|r와 검을 맞대며 그 후회를 이해하면서도 남을 구하고 싶었던 처음의 마음까지 잘못은 아니라고 답한다. 고통스러운 미래를 알아도 이상을 버리지 않겠다는 선택으로 대결은 결착을 맞는다. 한편 |cFF006B8F랜서|r는 키레이가 령주로 자결시켜 치명상을 입은 뒤에도 그를 죽여 |cFF006B8F린|r을 풀어 준다. 린은 살아나지만 랜서는 돌아오지 못한다."
        set ProtoEventDialogueFirst[81] = 4
        set ProtoDialogueStory[4] = "|cFF006B8F아처|r는 |cFF006B8F시로|r가 도달할 수도 있는 미래의 자신이다. 사람을 구하려 |cFF865500수호자|r가 되었지만 죽은 뒤에도 재앙을 막는다는 명목으로 구하고 싶던 사람들까지 죽여야 했다. 절망한 그는 이상을 품었던 과거의 자신을 부정하려 한다.|n|n아처 · 아처는 그 미래를 알고도 같은 길을 갈 수 있느냐고 시로를 몰아세운다."
        set ProtoDialogueChoices[4] = 2
        set ProtoDialogueNext[4] = 5
        set ProtoDialogueLabel[16] = "처음 구하고 싶었던 사람까지 잘못은 아니잖아."
        set ProtoDialogueResult[16] = "|cFF006B8F시로|r는 |cFF006B8F아처|r가 겪은 고통을 부정하지 않는다. 하지만 누군가를 구하고 싶었던 마음까지 거짓으로 만들지는 않겠다고 맞선다."
        set ProtoDialogueLabel[17] = "후회를 듣고도 |cFF006B8F시로|r가 답할 자리는 남겨 줘."
        set ProtoDialogueResult[17] = "|cFF006B8F시로|r는 |cFF006B8F아처|r의 삶을 알게 된 뒤 자신의 대답을 내놓는다. 고통이 있다는 사실만으로 처음의 바람이 잘못이었다고 하지는 않는다."
        set ProtoDialogueStory[5] = "같은 성에서 |cFF006B8F린|r을 찾아간 |cFF006B8F랜서|r 앞에는 그의 마스터였던 키레이가 나타난다. 키레이는 린을 죽이라고 명령한다. 계약으로 묶인 영령에게 따르고 싶지 않은 명령이 내려온 순간이다.|n|n랜서 · 키레이의 명령과 붙잡힌 린을 앞에 두고 랜서가 대답하려 한다."
        set ProtoDialogueChoices[5] = 1
        set ProtoDialogueNext[5] = 0
        set ProtoDialogueLabel[20] = "|cFF006B8F린|r을 죽일 이유는 없어."
