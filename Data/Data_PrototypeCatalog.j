        set ProtoEventChoices[99] = 4
        set ProtoEventStory[99] = "상인이 비탈에서 빠뜨린 운반 상자를 찾아 달라며 길가에 의뢰 쪽지를 남겼다. 나즈린의 다우징 막대는 진흙 아래를 가리키지만 나무 상자인지 고철인지는 아직 알 수 없다. 들쥐들이 먹을 것부터 먹어 버렸다는 말에, 남은 반응과 수색 범위를 따로 살핀다."
        set ProtoEventIntro[99] = "탐색을 배우거나 넓은 구역을 맡을지, 불확실한 반응에 비용을 쓸지 정한다."
