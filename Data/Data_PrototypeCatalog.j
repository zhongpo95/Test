        set ProtoEventDialogueEnabled[340] = 1
        set ProtoEventCommonResult[340] = "|cFF006B8F루키아|r에게 기다리는 것이 처형이라는 사실을 알게 된 |cFF006B8F이치고|r는 자신과 가족을 구한 사람을 그대로 버릴 수 없다고 결심한다. 하지만 지금은 그녀를 따라갈 힘부터 되찾아야 한다."
