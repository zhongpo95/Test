        set ProtoEventFailure[346] = ""
        set ProtoEventDialogueEnabled[346] = 1
        set ProtoEventCommonResult[346] = "간쥬가 그 과거를 마주한 감옥 앞에 |cFF006B8F뱌쿠야|r가 나타나 일행을 공격한다. 치료를 받은 |cFF006B8F이치고|r가 돌아와 막아서지만 |cFF006B8F요루이치|r가 싸움을 끊고 그를 데려간다. |cFF006B8F루키아|r에게 닿았어도, 지금의 힘으로 뱌쿠야를 넘기는 어렵다."
        set ProtoEventDialogueFirst[346] = 45
        set ProtoDialogueStory[45] = "카이엔은 |cFF006B8F루키아|r가 존경하던 선배로, 아내를 죽인 호로와 싸우다 몸을 빼앗겨 동료들을 공격했다. 루키아는 자신에게 달려든 그를 찔러 싸움을 끝냈지만, 선배를 죽였다는 죄책감을 놓지 못했다.|n|n루키아 · 존경하던 선배였어. 그날 일을 잊은 적은 없어."
        set ProtoDialogueChoices[45] = 2
