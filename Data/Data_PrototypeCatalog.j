        set ProtoEventEpilogue[384] = 0
        set ProtoEventGrade[384] = 2
        set ProtoEventStory[384] = "시계 스튜디오 테마파크의 무대 위로 어벤츄린의 칩이 쏟아진다. 자신의 목숨까지 건 승부 끝에 아케론이 검을 뽑고, 패밀리가 안전하다고 장담하던 꿈의 장막에 균열이 생긴다. 무대에서 사라진 도박꾼이 원했던 것은 단순한 승리보다 그 너머로 갈 기회였다."
        set ProtoEventIntro[384] = "어벤츄린의 큰 승부가 꿈의 안전이라는 약속을 시험한다. 지금 보이는 결말이 정말 전부인지 묻게 된다."
