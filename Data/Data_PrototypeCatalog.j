        set ProtoEventRequiredCard[342] = 0
        set ProtoEventFailure[342] = ""
        set ProtoEventDialogueEnabled[342] = 1
        set ProtoEventCommonResult[342] = "쿠카쿠는 일행을 감싸는 영력의 구체를 대포로 쏘아 장벽을 넘기는 방법을 제시한다. 그녀의 동생 간쥬도 동행한다. 구출 일행은 정문 대신 하늘을 통해 정령정 안으로 진입할 준비를 한다."
        set ProtoEventDialogueFirst[342] = 0
