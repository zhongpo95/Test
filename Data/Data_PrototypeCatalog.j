        set ProtoEventEpilogue[381] = 0
        set ProtoEventGrade[381] = 2
        set ProtoEventStory[381] = "블랙 스완은 기억이 단순한 기록처럼 보일 때일수록 신중하게 읽어야 한다고 일깨운다. 같은 장면의 빈틈과 서로 맞지 않는 설명이 드러난다. 처음 호텔에서 들었던 말, 반디와 나눈 약속, 사건을 목격한 순간을 순서대로 놓는다. 모든 것을 설명해 주는 한 문장을 기다리기보다 무엇이 아직 모르는 사실인지 구분한다. 이 의문을 이용하려는 또 다른 방문객, 어벤츄린의 제안이 다가온다."
        set ProtoEventIntro[381] = "블랙 스완과 기억을 되짚는다. 선명하게 떠오르는 장면도 누가, 어떻게 보았는지 확인해야 한다."
