        set ProtoEventIntro[425] = "|cFF006B8F에드|r의 생명이 위태로운 순간 |cFF006B8F알|r이 메이를 부른다."
        set ProtoEventIcon[425] = "war3mapImported\\UI_EventThumb_Card_FCU8_alphonse_Art.tga"
