        set ProtoEventFailure[487] = ""
        set ProtoEventDialogueEnabled[487] = 1
        set ProtoEventCommonResult[487] = "진짜 |cFF006B8F카이저|r가 나타나 |cFF006B8F쥰|r을 무력화한다. |cFF006B8F페코린느|r와 |cFF006B8F캐르|r는 다시 위험에 몰린다. 캐르가 주인에게 품은 오래된 애착도 두려움도 남아 있다. 페코린느는 그 마음까지 가진 친구를 구하려 하지만 두 사람만으로 빠져나가기 어렵다."
        set ProtoEventDialogueFirst[487] = 81
        set ProtoDialogueStory[81] = "|cFF006B8F페코린느|r에게 패한 쥰은 조종에서 벗어나 다시 왕녀를 지키는 편에 선다. 페코린느는 |cFF006B8F카이저|r에게 맞서 |cFF006B8F캐르|r를 받아 낸다. 하지만 쓰러뜨린 상대의 몸이 |cFF865500쉐도우|r로 무너지기 시작한다.|n|n페코린느 · 페코린느가 품 안의 캐르를 살핀다."
        set ProtoDialogueChoices[81] = 2
        set ProtoDialogueNext[81] = 0
