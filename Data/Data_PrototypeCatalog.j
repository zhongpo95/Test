        set ProtoDialogueResult[268] = "|cFF006B8F에드|r는 자신의 연금술이 막힌 이유부터 알아야 한다고 한다."
        set ProtoDialogueLabel[269] = "동행자 · 주변 사람을 지킬 길부터 마련하자."
        set ProtoDialogueResult[269] = "|cFF006B8F알|r은 자신들 밖의 사람들도 위협받는다는 사실을 잊지 않겠다고 답한다."
