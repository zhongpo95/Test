        set ProtoEventRequiredCard[380] = 0
        set ProtoEventFailure[380] = ""
        set ProtoEventDialogueEnabled[380] = 1
        set ProtoEventCommonResult[380] = "|cFF006B8F블랙 스완|r의 개입으로 당장의 위기를 넘기고, 당신은 |cFF80560C꿈|r에서 깨어난다. 안전한 관광 구역 뒤에 이런 장소가 있다는 사실은 패밀리의 설명과 맞지 않는다. 꿈속 호텔에서 무슨 일이 벌어지는지 확인하기 위해 당신은 다시 입몽한다. |cFF006B8F반디|r와도 다시 만나야 한다."
        set ProtoEventDialogueFirst[380] = 0
        set ProtoBranchLabel[1520] = "“|cFF006B8F반디|r도 같이!”"
        set ProtoBranchResult[1520] = "|cFF006B8F블랙 스완|r은 당신이 |cFF006B8F반디|r를 돌아보는 모습을 보고 고개를 끄덕인다. 당신도 반디와 떨어지지 않도록 거리를 좁히며 그녀의 손짓을 따른다."
