        set ProtoEventGrade[368] = 1
        set ProtoEventStory[368] = "대극장의 사전 공연 안내 자리에서 네 앞의 관객들이 로빈의 이름을 번갈아 외쳐 뒤쪽 사람은 시작 안내를 듣지 못한다. 로빈은 아직 노래를 시작하지 않고 뒤편에서도 안내가 들렸는지 묻는다. 너는 함께 이름을 외치려던 친구에게 기다릴 이유를 말할지, 다른 자리에서 듣도록 도울지 정한다. 갤러거는 돌아갈 관객의 보급을 아직 시작하지 않은 공연과 나누려 한다."
        set ProtoEventIntro[368] = "이름을 부르는 친구와 안내를 듣지 못한 관객 사이에서 맡을 일을 정한다."
