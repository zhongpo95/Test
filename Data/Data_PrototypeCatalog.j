        set ProtoEventRequiredChoice[113] = 0
        set ProtoEventRequiredCard[113] = 0
        set ProtoEventFailure[113] = ""
        set ProtoEventDialogueEnabled[113] = 1
        set ProtoEventCommonResult[113] = ""
        set ProtoEventDialogueFirst[113] = 9
        set ProtoDialogueStory[9] = "위즈는 |cFF006B8F카즈마|r에게 받은 힘으로 |cFF865500동력원|r을 전송한다. 그러나 요새에 남은 열 때문에 화재 위험이 계속된다. |cFF006B8F메구밍|r은 이미 마력을 다 썼다. 카즈마는 드레인 터치로 |cFF006B8F아쿠아|r의 마력을 메구밍에게 전달할 방법을 떠올린다.|n|n카즈마 · 아쿠아의 힘을 메구밍에게 이어 주면 마지막 폭렬을 쓸 수 있다."
        set ProtoDialogueChoices[9] = 2
        set ProtoDialogueNext[9] = 10
        set ProtoDialogueLabel[36] = "|cFF006B8F아쿠아|r, 조금만 버텨 줘."
        set ProtoDialogueResult[36] = "|cFF006B8F아쿠아|r는 왜 자기 힘까지 가져가느냐고 불평한다. |cFF006B8F카즈마|r가 그 마력을 메구밍에게 전하자 마지막 폭렬을 쓸 힘이 돌아온다."
        set ProtoDialogueLabel[37] = "|cFF006B8F메구밍|r, 마지막은 네 차례야."
        set ProtoDialogueResult[37] = "메구밍은 마지막 한 방을 맡겠다고 한다. |cFF006B8F아쿠아|r의 힘이 |cFF006B8F카즈마|r를 거쳐 닿자 지켜 낼 마을을 향한 공격을 준비한다."
        set ProtoDialogueStory[10] = "전해 받은 마력으로 |cFF006B8F메구밍|r이 마지막 폭렬을 일으켜 요새를 완전히 파괴하고 액셀을 구한다. 일행은 영웅이 되지만 전송된 |cFF865500동력원|r이 다른 곳에 피해를 주었다는 책임도 남는다. 그래도 |cFF80560C마을|r과 함께 마련한 집은 무사하다. 서로의 약점까지 이어 쓴 싸움으로 돌아갈 곳을 지켜 냈다.|n|n요새가 무너진 뒤 일행은 지켜 낸 집으로 돌아간다. 마을을 구했다는 환호 뒤로, 다른 곳에 날아간 동력원의 배상 이야기도 따라온다. |cFF006B8F카즈마|r가 문 앞에서 한숨을 쉬자 동료들의 말이 겹친다.|n|n카즈마와 동료들 · 돌아온 일행에게 어떤 말을 건넬까?"
        set ProtoDialogueChoices[10] = 2
        set ProtoDialogueNext[10] = 0
        set ProtoDialogueLabel[40] = "오늘은 들어가서 쉬자. 계산은 그다음이야."
        set ProtoDialogueResult[40] = "|cFF006B8F카즈마|r는 계산이 사라진 건 아니라며 투덜대면서도 문을 연다. 소란스러운 네 사람이 같은 집으로 들어간다."
        set ProtoDialogueLabel[41] = "집은 지켰잖아. 내일도 같이 벌면 되지."
        set ProtoDialogueResult[41] = "|cFF006B8F카즈마|r는 벌기도 전에 쓸 생각부터 하지 말라고 동료들에게 말한다. 불평 속에서도 다음 의뢰를 받을 파티는 그대로다."
