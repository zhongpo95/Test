        set ProtoEventKey[433] = "kny_night_path"
        set ProtoEventName[433] = "울음 사이로 섞인 발소리"
        set ProtoEventHead[433] = 12
        set ProtoEventKind[433] = 1
        set ProtoEventChoices[433] = 3
        set ProtoEventAPCost[433] = 1
        set ProtoEventMainStage[433] = 0
        set ProtoEventEpilogue[433] = 0
        set ProtoEventGrade[433] = 1
        set ProtoEventStory[433] = "|cFF80560C약속|r된 시각이 지났음에도 보급꾼은 나타나지 않았고, 길목에는 |cFF865500주인 잃은 짐더미|r만 덩그러니 놓여 있다. 젠이츠는 멀리서 들려오는 기묘한 소리에 귀를 기울이며 멈춰 서고, 이노스케는 거칠게 앞길을 가로막는 수풀을 헤치며 나아가려 한다.|n|n|cFF006B8F탄지로|r는 성급한 행동을 만류하며 눈앞에 놓인 상황들을 먼저 짚어보자고 제안한다."
        set ProtoEventIntro[433] = "보급꾼을 찾을지, 길을 뚫을지, 남은 짐을 먼저 수습할지 정한다."
        set ProtoEventIcon[433] = "war3mapImported\\UI_EventThumb_Card_KMO1_zenitsu_Art.tga"
        set ProtoEventImageAspect[433] = 1.777778
        set ProtoEventRequired[433] = 0
        set ProtoEventRequiredChoice[433] = 0
        set ProtoEventRequiredCard[433] = 0
        set ProtoEventFailure[433] = "보급꾼의 |cFF80560C목소리|r로 짐작한 소리는 다른 울음이었고, 준비비를 쓴 수색은 허탕으로 끝났다. 사람을 찾지 못한 |cFF80560C기록|r과 맡은 구역의 더 강한 적이 남아 돌아갈 짐을 다시 꾸린다."
        set ProtoBranchLabel[1732] = "등불과 밧줄을 마련해 젠이츠가 짚은 길을 확인한다"
        set ProtoBranchResult[1732] = "등불과 밧줄에160골드를 내고 소리를 따라 길을 잃은 보급꾼을 찾았다. 보급꾼이 돌아갈 길을 묻자 젠이츠는 들어온 소리와 나갈 발소리를 다시 나누어 듣는다."
        set ProtoBranchCard[1732] = 798
        set ProtoBranchCard2[1732] = 0
        set ProtoBranchGold[1732] = 0
        set ProtoBranchCost[1732] = 160
        set ProtoBranchLevel[1732] = 1
        set ProtoBranchDensity[1732] = 0
