        set ProtoEventRequiredChoice[210] = 0
        set ProtoEventRequiredCard[210] = 0
        set ProtoEventFailure[210] = "같은 자국에 겹친 냄새를 끝내 나누지 못했다. 조사비는 돌아오지 않고 보상도 없다. 맡기로 한 더 강한 구역은 남는다."
        set ProtoBranchLabel[840] = "도구를 마련해 탄지로가 짚은 흔적을 조사한다"
        set ProtoBranchResult[840] = "탄지로와 남은 흔적을 나누어 확인하고 조사 보수를 받았다. 관찰한 약점을 공격 준비로 남겼지만, 조사하며 맡기로 한 구역에는 더 강한 적이 남는다. 잃어버린 사람을 찾은 사건은 아니다."
