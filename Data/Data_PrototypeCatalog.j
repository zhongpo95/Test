        set ProtoEventAPCost[383] = 1
        set ProtoEventMainStage[383] = 8
        set ProtoEventEpilogue[383] = 0
        set ProtoEventGrade[383] = 2
        set ProtoEventStory[383] = "스파클의 말은 사실과 연기를 쉽게 구분하지 못하게 만든다. 누군가의 얼굴을 하고 나타난다고 그 사람의 뜻까지 대신하는 것은 아니다. 반디의 기억과 어벤츄린의 제안에서 확인한 것을 떠올리며, 흥미로운 이야기와 믿을 근거를 나눈다. 이 대화에서 스파클을 굴복시키거나 모든 진실을 얻을 필요는 없다. 가면에 끌려 판단을 넘기지 않는 것만으로 다음 시험을 맞을 준비가 된다."
        set ProtoEventIntro[383] = "스파클은 서로 다른 얼굴과 말로 반응을 살핀다. 웃음에 휩쓸리지 않고 앞서 확인한 사실을 되짚는다."
        set ProtoEventIcon[383] = "ReplaceableTextures\\CommandButtons\\BTNTome.blp"
