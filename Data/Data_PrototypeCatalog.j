        set ProtoDialogueResult[104] = "|cFF006B8F키리토|r는 움직임을 멈추고 |cFF006B8F사치|r의 목소리에 귀를 기울인다. 돌아올 수 없는 사람의 말이 방 안에 이어진다."
        set ProtoDialogueLabel[105] = "|cFF006B8F사치|r의 이름을 작게 부른 뒤 재생을 이어 간다."
        set ProtoDialogueResult[105] = "대답을 되돌려 줄 수는 없다. |cFF006B8F키리토|r는 그녀가 남긴 말을 놓치지 않으려 녹음에 집중한다."
