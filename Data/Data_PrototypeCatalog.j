        set ProtoEventRequiredCard[626] = 0
        set ProtoEventFailure[626] = ""
        set ProtoEventDialogueEnabled[626] = 1
        set ProtoEventCommonResult[626] = "머리를 찾는 |cFF006B8F셀티|r의 사연과 여성의 정체, 야기리 제약의 움직임이 연결되기 시작한다. |cFF006B8F미카도|r도 숨겨 왔던 자신의 역할을 마주한다."
        set ProtoEventDialogueFirst[626] = 105
        set ProtoDialogueStory[105] = "서로 알고 있는 사실이 달라 같은 말도 전혀 다르게 들린다. 대화를 어디서부터 잇겠는가?"
        set ProtoDialogueChoices[105] = 2
        set ProtoDialogueNext[105] = 0
        set ProtoDialogueLabel[420] = "직접 본 순서대로 말한다"
        set ProtoDialogueResult[420] = "본 사실과 추측을 나누자 어긋난 부분이 드러난다."
        set ProtoDialogueLabel[421] = "상대가 찾는 것이 무엇인지 되묻는다"
        set ProtoDialogueResult[421] = "같은 사람을 찾아도 목적까지 같지는 않음을 확인한다."
