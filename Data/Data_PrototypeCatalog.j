        set ProtoBranchLevel[836] = 0
        set ProtoBranchDensity[836] = 0
        set ProtoBranchPotions[836] = 0
        set ProtoBranchChance[836] = 100
        set ProtoBranchLabel[837] = "조사 도구를 사서 탄지로와 주변 흔적부터 확인한다"
        set ProtoBranchResult[837] = "조사 도구를 마련하고 짐에 묻은 것과 주변 자국을 차례로 비교했다. 탄지로가 짚어 준 상대를 관찰하는 요령을 공격 준비에 남겼다. 소리 자체는 남아 있지만 확인할 순서는 정했다."
        set ProtoBranchCard[837] = 184
        set ProtoBranchCard2[837] = 0
