        set ProtoEventHead[236] = 12
        set ProtoEventKind[236] = 1
        set ProtoEventChoices[236] = 3
        set ProtoEventStory[236] = "앞선 수색에서 찾았던 보급꾼이 돌아온 길을 기록지에 짚는다. 젠이츠는 소리를 듣는 것과 그 순간 몸을 움직이는 것은 다르다고 말하고, 카나오가 반응을 확인할 자리를 가리킨다. 정찰 뒤 어떤 준비를 더할지 정한다."
        set ProtoEventIntro[236] = "정찰 뒤 반응 카드·부담 감소와 물약·보수 정리 중 고른다."
