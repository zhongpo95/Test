        set ProtoBranchChance[1732] = 70
        set ProtoBranchLabel[1733] = "이노스케에게 먼저 감지한 방향을 묻는다"
        set ProtoBranchResult[1733] = "이노스케는 짐더미 뒤를 가리키며 자신이 느낀 기척을 주장한다. 거친 말투 속에서도 주변을 먼저 살피는 감각을 |cFF80560C기억|r한다."
