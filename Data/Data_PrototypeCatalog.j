        set ProtoDialogueResult[112] = "유이는 그 시간을 떠올린다. |cFF006B8F키리토|r와 |cFF006B8F아스나|r는 프로그램이라는 설명이 함께 보낸 날들을 지우지 않는다고 말한다."
        set ProtoDialogueLabel[113] = "“곁에 있고 싶어서 온 거였구나.”"
