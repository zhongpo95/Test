        set ProtoEventFailure[240] = ""
        set ProtoEventDialogueEnabled[240] = 1
        set ProtoEventCommonResult[240] = "관리 권한을 쓴 |cFF006B8F유이|r는 시스템의 삭제 대상이 된다. |cFF006B8F키리토|r는 사라지기 직전 그녀의 데이터를 보존해 작은 결정에 담는다. 두 사람은 지금 유이를 되살리지는 못해도 다시 만날 가능성을 품는다. 호숫가의 집으로 돌아갈 때도 함께한 |cFF80560C기억|r은 남는다."
        set ProtoEventDialogueFirst[240] = 28
        set ProtoDialogueStory[28] = "|cFF006B8F유이|r가 관리 권한으로 적을 없애고 |cFF80560C기억|r을 되찾는다. 그녀는 플레이어의 마음을 돌보도록 만들어진 인공지능이었지만, 데스 게임 이후 사람들과 접촉하지 못했다. 고통만 지켜보다 서로를 믿는 두 사람에게 이끌렸다고 말한다.|n|n|cFF006B8F키리토|r · 함께 지냈던 아이의 설명에 답한다."
        set ProtoDialogueChoices[28] = 2
