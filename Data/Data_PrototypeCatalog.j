        set ProtoEventKey[498] = "amphoreus_main_01"
        set ProtoEventName[498] = "여명이 머무는 도시"
        set ProtoEventHead[498] = 14
        set ProtoEventKind[498] = 1
        set ProtoEventChoices[498] = 3
        set ProtoEventAPCost[498] = 1
        set ProtoEventMainStage[498] = 1
        set ProtoEventEpilogue[498] = 0
        set ProtoEventGrade[498] = 1
        set ProtoEventStory[498] = "|cFF006B8F개척자|r와 단항이 앰포리어스에 도착한다. |cFF006B8F아글라이아|r는 세계를 잠식하는 |cFF865500검은 물결|r과 불씨를 되찾는 여정을 설명한다. |cFF006B8F트리비|r의 안내를 따라 도시를 보니, 구해야 할 세계에는 이름 모를 사람들의 일상도 있었다."
        set ProtoEventIntro[498] = "|cFF865500검은 물결|r 너머에 오크마의 빛이 남아 있다."
        set ProtoEventIcon[498] = "war3mapImported\\UI_EventThumb_XP_amphoreus_aglaea.tga"
        set ProtoEventImageAspect[498] = 1.777778
        set ProtoEventRequired[498] = 0
        set ProtoEventRequiredChoice[498] = 0
        set ProtoEventRequiredCard[498] = 0
        set ProtoEventFailure[498] = ""
        set ProtoEventDialogueEnabled[498] = 1
        set ProtoEventCommonResult[498] = "|cFF80560C도시|r의 환대는 여정의 시작이 된다. 일행은 황금의 후예들과 |cFF865500불씨|r를 되찾을 길로 나선다."
        set ProtoEventDialogueFirst[498] = 0
        set ProtoBranchLabel[1992] = "|cFF80560C도시|r가 지키는 사람들의 얼굴을 본다"
        set ProtoBranchResult[1992] = "거대한 예언을 듣기 전에 이곳에서 살아가는 사람들을 |cFF80560C기억|r한다."
