        set ProtoEventGrade[387] = 3
        set ProtoEventStory[387] = "로빈과 선데이의 이야기는 어린 시절 돌보던 작은 새로 돌아간다. 약한 생명을 위험한 하늘로 내보내도 되는지, 보호하는 우리가 끝내 날아갈 길까지 막아도 되는지 남매의 답은 갈린다. 같은 새를 아꼈던 두 사람은 이제 페나코니의 행복 앞에서 서로 다른 미래를 바라본다."
        set ProtoEventIntro[387] = "로빈과 선데이는 같은 사람들을 아끼면서도 서로 다른 행복을 바라본다. 기억해 온 만남들이 판단의 기준이 된다."
