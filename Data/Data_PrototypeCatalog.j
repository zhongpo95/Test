        set ProtoDialogueLabel[204] = "|cFF006B8F이치고|r · 다음에는 먼저 말해 주세요."
        set ProtoDialogueResult[204] = "|cFF006B8F우라하라|r는 결과가 좋았다는 이유로 숨긴 책임이 없어지지는 않는다며 받아들인다."
        set ProtoDialogueLabel[205] = "|cFF006B8F이치고|r · 사과는 루키아에게도 전해 주세요."
