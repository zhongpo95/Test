        set ProtoEventRequiredCard[378] = 0
        set ProtoEventFailure[378] = ""
        set ProtoEventDialogueEnabled[378] = 1
        set ProtoEventCommonResult[378] = "당신이 사이에 나서자 소녀도 사정을 설명할 틈을 얻는다. 소란이 잦아든 뒤, 그녀는 자신을 |cFF006B8F반디|r라고 소개한다. 도움에 보답하고 싶다며 |cFF80560C도시|r 안내를 제안하는 반디의 손끝이 거리의 가게들을 가리킨다. 당신은 그 안내를 받아 함께 걷기 시작한다."
        set ProtoEventDialogueFirst[378] = 0
