        set ProtoEventKey[417] = "amestris_main_08"
        set ProtoEventName[417] = "영원을 탐내는 인조인간"
        set ProtoEventHead[417] = 11
        set ProtoEventKind[417] = 1
        set ProtoEventChoices[417] = 3
        set ProtoEventAPCost[417] = 1
        set ProtoEventMainStage[417] = 8
        set ProtoEventEpilogue[417] = 0
        set ProtoEventGrade[417] = 2
        set ProtoEventStory[417] = "|cFF006B8F그리드|r는 |cFF006B8F알|r을 납치해 갑옷에 혼을 묶어 둔 방법을 묻는다. 그는 호문쿨루스라는 인조인간으로 상처를 재생하는 힘을 가졌지만, 그보다 더 완전하게 |cFF704261죽지 않는 몸을 원한다.|r 알을 찾아온 |cFF006B8F에드|r가 그리드 앞에 선다.|n|n그리드 — 갑옷에 혼을 묶은 방법, 내게도 쓸모가 있겠는데."
        set ProtoEventIntro[417] = "|cFF006B8F알|r의 몸을 불멸의 기술로 여기는 |cFF006B8F그리드|r가 길을 막는다."
        set ProtoEventIcon[417] = "war3mapImported\\UI_EventThumb_Card_FMO3_greed_Art.tga"
        set ProtoEventImageAspect[417] = 1.777778
        set ProtoEventRequired[417] = 0
        set ProtoEventRequiredChoice[417] = 0
        set ProtoEventRequiredCard[417] = 0
        set ProtoEventFailure[417] = ""
        set ProtoEventDialogueEnabled[417] = 1
        set ProtoEventCommonResult[417] = "|cFF006B8F알|r이 원래 몸을 잃은 사정은 그에게 불멸의 기술로 보인다. |cFF006B8F에드|r는 동생을 구하려 |cFF006B8F그리드|r와 싸운다. 그리드 곁의 동료들은 군의 실험으로 인간과 동물이 합쳐진 키메라들이다. 이때 군 최고지도자 브래들리가 직접 진압에 나서 그리드 세력을 무너뜨린다. 알은 구하지만 군의 실험과 인조인간의 관계는 풀리지 않은 채 남는다. 형제는 사건을 뒤로하고 센트럴로 돌아가며, 그곳에서 자신들이 모르던 소식을 듣게 된다."
        set ProtoEventDialogueFirst[417] = 0
