        set ProtoEventFailure[379] = ""
        set ProtoEventDialogueEnabled[379] = 1
        set ProtoEventCommonResult[379] = "|cFF006B8F반디|r는 현실의 몸이 병 때문에 자유롭지 못하다고 털어놓는다. 이 꿈에서는 걷고, 음식을 고르고, 친구와 사진을 남기는 평범한 하루를 보낼 수 있다. |cFF80560C꿈|r이 병을 고쳐 주지는 않지만 그 시간마저 거짓은 아니다. 당신은 반디와 풍경을 사진에 남긴 뒤, 함께 호텔로 돌아간다."
        set ProtoEventDialogueFirst[379] = 0
        set ProtoBranchLabel[1516] = "“응, 듣고 있어.”"
