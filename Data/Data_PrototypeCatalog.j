        set ProtoEventMainStage[318] = 0
        set ProtoEventEpilogue[318] = 0
        set ProtoEventGrade[318] = 1
        set ProtoEventStory[318] = "우라하라 상점 앞에 세 갈래 길로 보낼 짐이 쌓였다. 콘이 끼어든 상자에는 수취인 이름이 가려져 있고, 젖어 갈라진 배송 쪽지를 이치고와 우류가 서로 다르게 읽는다. 오리히메는 부서진 운반대 때문에 뒷길의 짐이 멈췄다는 점을 알아챈다."
        set ProtoEventIntro[318] = "우라하라 상점 앞에 네 갈래 길로 보낼 짐이 쌓여 있다."
