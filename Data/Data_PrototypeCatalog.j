        set ProtoEventRequiredCard[175] = 0
        set ProtoEventFailure[175] = "회전판은 맞지 않은 그림에서 멈췄다. 바꿔 넣은 코인은 돌아오지 않았고 어벤츄린은 다음 판을 대신 돌려주지 않는다. 조용한 쪽으로 걸어가 잠깐 전의 선택을 돌아본다."
        set ProtoBranchLabel[700] = "코인을 바꾸고 어벤츄린과 한 번만 돌린다"
        set ProtoBranchResult[700] = "서로 다른 속도로 돌아가던 그림이 같은 줄에서 멈췄다. 받은 당첨금을 따로 챙기고 어벤츄린과 함께 다음 차례의 손님에게 자리를 넘겼다."
