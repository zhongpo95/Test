        set ProtoDialogueLabel[181] = "동행자 · 간쥬가 받아들일 시간도 필요할 거야."
        set ProtoDialogueResult[181] = "|cFF006B8F루키아|r는 간쥬가 당장 용서해야 한다고 생각하지 않는다며 고개를 숙인다."
