        set ProtoEventKey[231] = "aincrad_main_02"
        set ProtoEventName[231] = "첫 문을 열고 짊어진 이름"
        set ProtoEventHead[231] = 6
        set ProtoEventKind[231] = 1
        set ProtoEventChoices[231] = 3
        set ProtoEventAPCost[231] = 1
        set ProtoEventMainStage[231] = 2
        set ProtoEventEpilogue[231] = 0
        set ProtoEventGrade[231] = 1
        set ProtoEventStory[231] = "한 달이 지나도 첫 층을 넘지 못하자 기사 디아벨이 공략대를 모은다. |cFF006B8F키리토|r는 혼자 싸우던 검사 |cFF006B8F아스나|r와 짝을 맺는다.|n|n보스가 마지막에 꺼낸 무기는 시험 때와 달랐고, 예전 공격을 예상한 디아벨이 |cFFA53528치명상을 입는다|r. 바뀐 움직임을 따라잡지 못하면 더 많은 사람이 쓰러진다. 키리토는 아스나의 위치를 확인한다."
        set ProtoEventIntro[231] = "디아벨이 쓰러진 뒤 |cFF006B8F키리토|r가 |cFF006B8F아스나|r에게 외친다."
        set ProtoEventIcon[231] = "war3mapImported\\UI_EventThumb_Card_SAO1_kirito_Art.tga"
        set ProtoEventImageAspect[231] = 1.777778
        set ProtoEventRequired[231] = 0
        set ProtoEventRequiredChoice[231] = 0
        set ProtoEventRequiredCard[231] = 0
        set ProtoEventFailure[231] = ""
        set ProtoEventDialogueEnabled[231] = 1
        set ProtoEventCommonResult[231] = "|cFF006B8F키리토|r는 자신에게 쏠린 비난을 받아들이고 위층으로 떠난다. 사람들은 그를 시험 참가자와 부정행위자를 섞은 말인 비터로 부른다. 다음 층의 문은 열렸지만 키리토는 다른 사람들과 다시 거리를 두게 된다."
        set ProtoEventDialogueFirst[231] = 25
        set ProtoDialogueStory[25] = "협력 끝에 보스를 쓰러뜨린다. 그러나 디아벨을 잃은 공략대에서는 정보를 숨긴 시험 참가자들이 죽음을 막지 않았다는 비난이 나온다. |cFF006B8F키리토|r가 그 말 앞에 선다.|n|n키리토 · 다른 시험 참가자들에게도 적의가 번지려 한다."
        set ProtoDialogueChoices[25] = 2
        set ProtoDialogueNext[25] = 0
        set ProtoDialogueLabel[100] = "“내가 그들보다 훨씬 더 많이 알고 있었어.”"
        set ProtoDialogueResult[100] = "사람들의 시선이 |cFF006B8F키리토|r에게 집중된다. 그는 자신의 지식을 과장해 다른 시험 참가자들에게 향한 적의를 끌어온다."
        set ProtoDialogueLabel[101] = "자신에게 책임을 돌리는 말을 하고 앞에 선다."
        set ProtoDialogueResult[101] = "공략대원들은 |cFF006B8F키리토|r를 둘러싸고 비난한다. 그는 해명으로 다른 사람까지 끌어들이지 않고 그 시선을 받는다."
        set ProtoBranchLabel[924] = "|cFF006B8F키리토|r · “내 공격 뒤에 이어 줘.”"
        set ProtoBranchResult[924] = "|cFF006B8F아스나|r는 알겠다고 답하며 |cFF80560C검|r을 잡는다. 두 사람은 서로의 공격이 끝나는 순간을 살핀다."
