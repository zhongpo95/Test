        set ProtoEventEpilogue[377] = 0
        set ProtoEventGrade[377] = 1
        set ProtoEventStory[377] = "거리에서는 웃음과 광고가 끊이지 않는다. 미샤가 들려주었던 이야기에는 호텔의 작은 일과 더 넓은 세상을 보고 싶다는 꿈이 함께 있었다. 손님에게 길을 알려 주는 소년도 언젠가는 자신의 여행을 떠나고 싶은 모양이다. 즐거움이 넘치는 도시 안에서, 누가 손님을 위해 일하고 누가 정말 쉬고 있는지 눈에 들어오기 시작한다. 안내받은 길을 따라 새로운 얼굴을 만난다."
        set ProtoEventIntro[377] = "호텔에서 만난 소년 미샤의 설명을 떠올리며, 끝없이 밝은 황금의 순간을 걷는다."
