        set ProtoEventRequiredCard[84] = 0
        set ProtoEventFailure[84] = ""
        set ProtoEventDialogueEnabled[84] = 1
        set ProtoEventCommonResult[84] = ""
        set ProtoEventDialogueFirst[84] = 6
        set ProtoDialogueStory[6] = "|cFF006B8F아처|r의 지원으로 린과 신지는 탈출한다. |cFF006B8F세이버|r는 성배를 파괴하고 사라지며, 성배에 끌려가던 |cFF006B8F길가메시|r가 |cFF006B8F시로|r를 붙잡으려는 마지막 저항도 아처가 막는다. 싸움 뒤 린은 아처와 작별한다. 시로의 답은 그의 과거를 없애지는 못해도 처음의 이상을 다시 돌아보게 했다. 신지는 살아남고 일행은 학교생활로 돌아간다. 이후 시로와 린은 런던으로 향한다.|n|n영령들이 떠난 뒤의 학교생활이 지나간다. 런던으로 향하는 시로와 린에게 남은 것은 고통 없는 미래의 보장이 아니라 함께 걸을 사람이다. 떠나는 두 사람의 뒷모습 앞에 짧은 작별의 자리가 남는다.|n|n작별의 자리 · 이 길을 이어 가는 두 사람에게 어떤 말을 남길까?"
        set ProtoDialogueChoices[6] = 1
        set ProtoDialogueNext[6] = 0
        set ProtoDialogueLabel[24] = "서로를 놓치지 말고 다녀와."
        set ProtoDialogueResult[24] = "두 사람이 향하는 길은 아직 끝나지 않았다. 누군가를 구하려는 마음 곁에, 그 사람을 돌아보는 동행이 남는다."
        set ProtoBranchLabel[336] = "|cFF006B8F린|r, 그 손을 놓지 마."
        set ProtoBranchResult[336] = "|cFF006B8F린|r은 신지를 붙잡은 채 놓아 버리는 쪽을 택하지 않는다. 자신의 탈출도 함께 해결해야 한다."
        set ProtoBranchCard[336] = 924
