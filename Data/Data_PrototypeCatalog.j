        set ProtoEventFailure[350] = ""
        set ProtoEventDialogueEnabled[350] = 1
        set ProtoEventCommonResult[350] = "발견된 진실이 다른 사신들에게 전해지면서, 법을 지킨다고 믿었던 싸움 자체가 조작된 명령 아래 벌어졌음이 드러난다."
        set ProtoEventDialogueFirst[350] = 49
        set ProtoDialogueStory[49] = "그곳에 죽었다고 믿었던 |cFF006B8F아이젠|r이 살아서 나타난다. 그를 따랐던 히나모리는 아이젠에게 찔리고, 분노해 맞선 히츠가야도 쓰러진다. 아이젠의 참백도 경화수월은 해방을 본 상대의 감각을 지배해 거짓 시신과 혼란을 만들어냈다. 이치마루 긴과 대장 토센도 공범이었다.|n|n상황 · 죽었다던 아이젠과 그가 만든 기만이 드러났다. 무엇을 먼저 짚을까?"
        set ProtoDialogueChoices[49] = 2
        set ProtoDialogueNext[49] = 0
        set ProtoDialogueLabel[196] = "동행자 · 거짓 시신과 처형 명령을 연결한다."
        set ProtoDialogueResult[196] = "거짓 시신과 처형의 재촉은 따로 떨어진 소동이 아니라 하나의 기만으로 이어진다."
        set ProtoDialogueLabel[197] = "동행자 · 쓰러진 이들을 살필 사람이 필요하다."
        set ProtoDialogueResult[197] = "쓰러진 히나모리와 히츠가야의 모습은 진실을 알리는 일과 구조 모두가 급함을 보여 준다."
