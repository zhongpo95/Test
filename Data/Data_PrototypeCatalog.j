        set ProtoBranchChance[838] = 100
        set ProtoEventKey[210] = "kny_mixed_traces"
        set ProtoEventName[210] = "같은 자리에 남은 다른 냄새"
        set ProtoEventHead[210] = 12
        set ProtoEventKind[210] = 1
        set ProtoEventChoices[210] = 3
        set ProtoEventStory[210] = "저택 밖 보급길의 자국은 한 방향으로 이어지는데, 젖은 짐과 풀 냄새는 서로 다르게 남아 있다. 탄지로는 보이는 자국만 곧장 따르지 않고 냄새가 갈라지는 곳을 짚는다. 이노스케는 주변 길까지 직접 맡으면 알 수 있다고 나선다."
        set ProtoEventIntro[210] = "조사비와 강한 구역을 감수해 확인할지, 넓은 길을 맡을지, 확인한 곳만 남길지 정한다."
