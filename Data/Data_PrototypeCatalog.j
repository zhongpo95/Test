        set ProtoEventKey[429] = "amestris_main_father_underground"
        set ProtoEventName[429] = "지하의 아버지와 장악된 군"
        set ProtoEventHead[429] = 11
        set ProtoEventKind[429] = 1
        set ProtoEventChoices[429] = 3
