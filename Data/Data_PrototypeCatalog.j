        set ProtoEventCommonResult[337] = "그녀가 회복할 때까지 |cFF006B8F이치고|r가 사신의 일을 대신해야 한다."
        set ProtoEventDialogueFirst[337] = 41
        set ProtoDialogueStory[41] = "그러나 |cFF006B8F이치고|r는 뜻밖에도 그녀의 힘을 전부 받아 호로를 물리친다. 가족은 살았지만 |cFF006B8F루키아|r는 힘을 잃어 돌아갈 수 없게 된다.|n|n루키아 · 힘이 돌아오지 않아. 당장은 저쪽으로 갈 수도 없겠군."
