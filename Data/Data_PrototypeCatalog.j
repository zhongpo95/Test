        set ProtoEventDialogueFirst[427] = 66
        set ProtoDialogueStory[66] = "모든 대가가 지워진 결말은 아니다. 하지만 서로를 되찾은 형제는 도와준 사람들과 희생한 이들이 있었기에 여기까지 왔음을 안다. 회복을 거친 뒤에는 각자의 길에서 새로운 지식을 배우려 한다. 몸을 되찾기 위한 절박한 추적은 끝났지만 배움과 삶은 계속된다. |cFF006B8F에드|r에게 남은 것은 연금술이라는 힘만으로 세상을 바꾸려는 생각 대신, 다른 사람의 손을 잡고 자기 발로 걸어갈 수 있는 미래다.|n|n몸의 회복을 이어 가던 어느 오후, |cFF006B8F알|r이 창가에서 |cFF80560C책|r을 덮는다. 에드는 연금술을 잃었고 왼다리에는 여전히 의족이 있다. 그래도 이제 동생의 손을 직접 잡을 수 있다.|n|n알폰스 엘릭 · 몸을 찾으면 끝일 줄 알았는데, 아직 배우고 싶은 게 많아."
        set ProtoDialogueChoices[66] = 2
        set ProtoDialogueNext[66] = 0
        set ProtoDialogueLabel[264] = "|cFF006B8F에드|r · 서두르지 말자. 이번엔 네 몸으로 가는 길이야."
        set ProtoDialogueResult[264] = "|cFF006B8F알|r은 제 손가락을 한번 움직여 보고 웃는다. 조급하게 답을 얻기보다 몸을 회복하며 다음 여행을 준비하기로 한다."
        set ProtoDialogueLabel[265] = "|cFF006B8F에드|r · 다녀오면 배운 걸 서로 들려주자."
        set ProtoDialogueResult[265] = "|cFF006B8F알|r은 고개를 끄덕이며 형에게도 다녀온 이야기를 꼭 들려 달라고 한다. 혼자 모든 답을 찾을 필요 없이, 서로에게 전할 배움이 남아 있다."
