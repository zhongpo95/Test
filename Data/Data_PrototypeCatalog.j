        set ProtoEventFailure[177] = "진흙을 걷어 냈지만 막대가 가리킨 자리에서는 고철만 나왔다. 작업비는 돌아오지 않았고 깊은 구역의 강한 적도 그대로 남아, 의뢰 보수를 받지 못한 채 젖은 표시를 다시 살폈다."
        set ProtoBranchLabel[708] = "측정 자재를 보태고 나즈린과 반응을 대조한다"
        set ProtoBranchResult[708] = "비에 젖은 표시를 다시 세우고 나즈린과 여러 반응의 방향을 대조했다. 상자를 찾았다고 단정하지 않고 어떤 자리를 먼저 살필지 구분하는 경험을 남겼다."
