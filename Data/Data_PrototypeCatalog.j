        set ProtoEventMainStage[376] = 1
        set ProtoEventEpilogue[376] = 0
        set ProtoEventGrade[376] = 1
        set ProtoEventStory[376] = "레버리 호텔의 안내는 꿈에 들어가는 법부터 설명한다. 잠에서 깨면 돌아올 수 있다는 말에 경계가 조금 풀린다. 하지만 초대장을 다시 읽자 축제를 즐기라는 인사 너머, 직접 확인해야 할 무언가가 있다는 느낌이 남는다. 꿈속에서는 누구나 원하는 모습으로 살 수 있다고 한다. 그 약속이 정말 모두에게 같은 의미인지, 황금의 순간으로 향하며 알아보기로 한다."
        set ProtoEventIntro[376] = "레버리 호텔의 객실에 도착한다. 처음 온 곳인데도 초대장에는 누군가의 기다림이 남아 있다."
        set ProtoEventIcon[376] = "ReplaceableTextures\\CommandButtons\\BTNTome.blp"
