        set ProtoEventKind[210] = 1
        set ProtoEventChoices[210] = 3
        set ProtoEventAPCost[210] = 1
        set ProtoEventMainStage[210] = 14
        set ProtoEventEpilogue[210] = 0
        set ProtoEventGrade[210] = 4
        set ProtoEventStory[210] = "새 세계에서 마법소녀는 마녀가 되는 대신 마지막 순간 |cFF006B8F마도카|r의 이치에 이끌린다. |cFF006B8F사야카|r는 돌아오지 않아도 그녀의 소원으로 쿄스케의 연주는 이어진다.|n|n|cFF006B8F마미|r와 쿄코가 살아 있는 이곳에도 사람의 저주에서 생긴 마수는 남아 있다.|n|n대부분이 마도카를 잊은 가운데 |cFF006B8F호무라|r는 리본을 손에 쥔다. 다음 싸움에 나서기 전, 잠시 친구와 나눈 약속을 떠올린다."
        set ProtoEventIntro[210] = "남겨진 세계에서 |cFF006B8F호무라|r가 리본을 바라본다."
        set ProtoEventIcon[210] = "war3mapImported\\UI_EventThumb_Card_MEU10_homura_Art.tga"
        set ProtoEventImageAspect[210] = 1.777778
        set ProtoEventRequired[210] = 0
        set ProtoEventRequiredChoice[210] = 0
        set ProtoEventRequiredCard[210] = 0
        set ProtoEventFailure[210] = ""
        set ProtoEventDialogueEnabled[210] = 1
        set ProtoEventCommonResult[210] = ""
        set ProtoEventDialogueFirst[210] = 24
        set ProtoDialogueStory[24] = "|cFF006B8F호무라|r는 활을 들고 마수가 있는 곳으로 향한다. |cFF006B8F마도카|r가 남긴 것은 모든 문제가 해결된 낙원이 아니다. 소원을 빌었던 사람의 마지막을 절망으로만 정하지 않는 세계다. 호무라는 친구를 |cFF80560C기억|r하며 그 안에서 자신의 싸움을 이어 간다.|n|n도시의 |cFF80560C불빛|r이 멀어지고 리본을 맨 호무라의 뒷모습이 남는다. 활을 든 손이 잠시 멈춘다.|n|n호무라의 독백 · 함께 돌아오지는 못한 친구에게, 마음속으로 어떤 말을 남길까?"
        set ProtoDialogueChoices[24] = 3
        set ProtoDialogueNext[24] = 0
        set ProtoDialogueLabel[96] = "네가 지키려 했던 사람들을 나도 지킬게."
        set ProtoDialogueResult[96] = "|cFF006B8F호무라|r는 리본의 매듭을 확인한다. 친구가 남긴 세계에서 자신이 할 일을 정하고 다시 앞을 바라본다."
        set ProtoDialogueLabel[97] = "아무도 묻지 않아도, 나는 너를 |cFF80560C기억|r할게."
        set ProtoDialogueResult[97] = "|cFF006B8F호무라|r는 친구의 이름을 마음속으로 부른다. 대답이 없어도 그 이름을 잊지 않은 채 발걸음을 잇는다."
        set ProtoDialogueLabel[98] = "희망을 품었던 일이 잘못이었다고는 말하지 않을게."
        set ProtoDialogueResult[98] = "|cFF006B8F호무라|r는 소녀들이 품었던 소원을 떠올린다. 슬픔이 남아 있어도 친구가 바꾼 마지막을 지키려 활을 고쳐 쥔다."
        set ProtoBranchLabel[840] = "아케미 |cFF006B8F호무라|r · 리본을 매고 주위를 살핀다."
        set ProtoBranchResult[840] = "|cFF006B8F호무라|r는 매듭을 확인한 뒤 고개를 든다. 여전히 지켜야 할 사람들이 사는 거리가 눈앞에 펼쳐진다."
        set ProtoBranchCard[840] = 928
        set ProtoBranchCard2[840] = 0
