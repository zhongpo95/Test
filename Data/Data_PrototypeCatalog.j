        set ProtoEventDialogueFirst[569] = 97
        set ProtoDialogueStory[97] = "새 목록을 보던 |cFF006B8F푸딩세스|r가 묻는다. 안내를 끝내고 돌아올 사람을 기다리면 다과회 시작이 늦어지지 않을까? |cFF006B8F메신젤라또|r는 모두가 같은 시각에 앉을 방법보다 누구도 놓치지 않을 방법을 찾자고 한다."
        set ProtoDialogueChoices[97] = 2
