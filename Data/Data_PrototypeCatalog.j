        set ProtoEventGrade[385] = 2
        set ProtoEventStory[385] = "꿈이 흐르는 암초에는 황금의 순간과 다른 하루가 이어지고 있다. 반짝이는 광고 대신 사람들의 대화가 들리고, 사라졌다고 여겼던 이들을 만날 길도 이곳에 남아 있다. 호텔이 보여 준 풍경만으로는 페나코니를 다 보았다고 말할 수 없다."
        set ProtoEventIntro[385] = "황금의 순간과 다른 풍경에 도착한다. 꿈이 흐르는 암초에는 축제의 안내에서 빠졌던 삶이 이어지고 있다."
