        set ProtoDialogueResult[276] = "|cFF006B8F그리드|r는 남이 시키는 대로 살 생각은 없다며 자기 뜻을 고집한다."
        set ProtoDialogueLabel[277] = "|cFF006B8F린|r의 의식 · 나도 백성을 희생시키는 일을 막으려 해."
        set ProtoDialogueResult[277] = "|cFF006B8F그리드|r는 |cFF006B8F린|r의 뜻과 자신의 분노가 같은 적을 향할 수 있음을 인정한다."
        set ProtoBranchLabel[1724] = "|cFF006B8F린|r의 의식 · 잃은 동료를 모른 척하지 마."
        set ProtoBranchResult[1724] = "|cFF006B8F그리드|r는 이미 잃은 일을 들추지 말라며 반발하지만 |cFF006B8F린|r의 말을 떨쳐 내지 못한다."
