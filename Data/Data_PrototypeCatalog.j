        set ProtoEventKey[465] = "pc_road_meal"
        set ProtoEventName[465] = "냄비를 올리기 전에"
        set ProtoEventHead[465] = 13
        set ProtoEventKind[465] = 1
        set ProtoEventChoices[465] = 3
        set ProtoEventAPCost[465] = 1
        set ProtoEventMainStage[465] = 0
        set ProtoEventEpilogue[465] = 0
        set ProtoEventGrade[465] = 1
        set ProtoEventStory[465] = "의뢰를 마친 |cFF865500미식전|r이 길가에 냄비를 내려놓는다. |cFF006B8F페코린느|r는 식재료 바구니를 들여다보며 자기 몫을 몇 번이고 다시 세고, |cFF006B8F콧코로|r는 다음 끼니에 쓸 재료를 따로 묶는다.|n|n캬루는 잘린 재료 냄새를 따라 다가오는 적을 가리키며, 먹기 전에 자리부터 정하자고 투덜거린다."
        set ProtoEventIntro[465] = "더 모아 함께 먹을지, 다음 끼니를 준비할지, 식사 자리를 줄일지 정한다."
        set ProtoEventIcon[465] = "war3mapImported\\UI_EventThumb_Card_PCR_105831_Art.tga"
        set ProtoEventImageAspect[465] = 1.777778
        set ProtoEventRequired[465] = 0
        set ProtoEventRequiredChoice[465] = 0
        set ProtoEventRequiredCard[465] = 0
        set ProtoEventFailure[465] = ""
        set ProtoBranchLabel[1860] = "|cFF006B8F페코린느|r와 넓은 구역의 재료를 모아 넉넉히 차린다"
        set ProtoBranchResult[1860] = "|cFF006B8F페코린느|r가 정성껏 준비한 음식을 나누며 |cFF865500미식전|r의 유대감을 확인한다. 따뜻한 온기 속에서 길드원들의 신뢰가 깊어진 기억을 얻는다."
        set ProtoBranchCard[1860] = 858
        set ProtoBranchCard2[1860] = 0
        set ProtoBranchGold[1860] = 0
        set ProtoBranchCost[1860] = 0
        set ProtoBranchLevel[1860] = 0
        set ProtoBranchDensity[1860] = 0
        set ProtoBranchPotions[1860] = 0
        set ProtoBranchChance[1860] = 100
        set ProtoBranchLabel[1861] = "밀봉된 재료를 구해 |cFF006B8F콧코로|r와 끼니를 나누어 준비한다"
        set ProtoBranchResult[1861] = "장보기 비용을 내고 밀봉 재료를 더 샀다. |cFF006B8F콧코로|r와 오늘 먹을 몫과 다음 끼니를 나누어 담으며, 출발 전에 작은 준비를 빠뜨리지 않는 법을 익힌다."
        set ProtoBranchCard[1861] = 860
        set ProtoBranchCard2[1861] = 0
        set ProtoBranchGold[1861] = 0
        set ProtoBranchCost[1861] = 260
        set ProtoBranchLevel[1861] = 0
        set ProtoBranchDensity[1861] = 0
        set ProtoBranchPotions[1861] = 0
        set ProtoBranchChance[1861] = 100
        set ProtoBranchLabel[1862] = "캬루와 길목을 확인하고 식사 준비를 좁힌다"
        set ProtoBranchResult[1862] = "캬루의 조언대로 안전한 구역을 확보하며 식사 준비에 집중한다. 세심한 배려 덕분에 서로를 믿는 소중한 |cFF80560C기억|r을 얻는다."
