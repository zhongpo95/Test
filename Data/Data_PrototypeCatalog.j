        set ProtoEventEpilogue[386] = 0
        set ProtoEventGrade[386] = 3
        set ProtoEventStory[386] = "미샤와 함께 따라간 꿈의 끝에서 소년의 정체가 드러난다. 미샤는 시계공 미하일이 남긴 어린 시절의 꿈에서 태어난 존재였고, 먼 곳을 향한 동경은 한 개척자의 긴 여행으로 이어져 있었다. 남겨진 모자는 다음 여행자가 페나코니의 앞날을 이어 달라는 부탁이 된다."
        set ProtoEventIntro[386] = "미샤와 연결된 옛 개척의 기억을 마주한다. 처음 받은 초대장이 단순한 축제 안내가 아니었음을 알게 된다."
