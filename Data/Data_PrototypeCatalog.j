        set ProtoEventRequiredCard[341] = 0
        set ProtoEventFailure[341] = ""
        set ProtoEventDialogueEnabled[341] = 1
        set ProtoEventCommonResult[341] = "그동안 오리히메와 차드, 우류도 각자 동행을 준비한다. |cFF006B8F우라하라|r의 협력과 말하는 |cFF80560C검|r은 고양이 |cFF006B8F요루이치|r의 안내를 받아, 일행은 |cFF006B8F루키아|r가 끌려간 소울 소사이어티로 향한다."
        set ProtoEventDialogueFirst[341] = 43
        set ProtoDialogueStory[43] = "위험한 수련 속에서 |cFF006B8F이치고|r는 내면의 존재와 마주하고 자신의 칼이 지닌 이름, 참월을 알아낸다. 참백도는 단순한 철이 아니라 이름과 의지를 가진 사신의 칼이다. 이치고는 참월을 통해 다시 싸울 힘을 얻는다.|n|n이치고 · 참월. 이제 내 칼의 이름을 알았어."
        set ProtoDialogueChoices[43] = 2
        set ProtoDialogueNext[43] = 0
        set ProtoDialogueLabel[172] = "동행자 · 이번에는 그 이름을 잊지 마."
        set ProtoDialogueResult[172] = "|cFF006B8F이치고|r는 칼을 내려다보며 이제 혼자 휘두르는 것이 아니라고 답한다."
        set ProtoDialogueLabel[173] = "동행자 · 함께 갈 사람들도 기다리고 있어."
        set ProtoDialogueResult[173] = "|cFF006B8F이치고|r는 자신만 준비하는 게 아니었다며 동료들을 떠올린다."
