        set ProtoEventKey[499] = "amphoreus_main_02"
        set ProtoEventName[499] = "신에게 닿는 첫 발"
        set ProtoEventHead[499] = 14
        set ProtoEventKind[499] = 1
        set ProtoEventChoices[499] = 3
        set ProtoEventAPCost[499] = 1
        set ProtoEventMainStage[499] = 2
        set ProtoEventEpilogue[499] = 0
        set ProtoEventGrade[499] = 1
        set ProtoEventStory[499] = "|cFF006B8F파이논|r과 |cFF006B8F마이데이|r, |cFF006B8F개척자|r는 니카도르에게 맞서는 길에 선다. 신의 힘을 마주한 뒤에는 용맹이라는 말만으로 설명되지 않는 무게가 남는다. 승리와 |cFF865500불씨|r의 회수 뒤에도 그것을 이어받을 시련은 끝나지 않는다."
