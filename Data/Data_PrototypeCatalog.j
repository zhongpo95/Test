        set ProtoDialogueLabel[177] = "동행자 · 너도 살아서 다시 만나."
        set ProtoDialogueResult[177] = "|cFF006B8F렌지|r는 살아서 들을 말이 남았다며 힘겹게 고개를 끄덕인다."
