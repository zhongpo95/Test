        set ProtoEventAPCost[379] = 1
        set ProtoEventMainStage[379] = 4
        set ProtoEventEpilogue[379] = 0
        set ProtoEventGrade[379] = 2
        set ProtoEventStory[379] = "반디는 눈앞의 풍경을 보며 꿈에서 누릴 수 있는 시간을 소중히 여긴다고 말한다. 현실에서는 당연하지 않았던 일이 이곳에서는 자연스럽다. 그래서 이 평온을 가볍게 약속할 수 없다는 것도 느껴진다. 사진을 남기고 다시 거리로 내려가기로 한다. 꿈이 끝나도 만남의 의미까지 사라지는 것은 아니라는 말을, 아직은 완전한 답 대신 조심스러운 약속으로 건넨다."
        set ProtoEventIntro[379] = "반디가 아끼는 전망에 도착한다. 도시의 소란은 멀어지고, 지금의 모습으로 남고 싶다는 바람이 들린다."
