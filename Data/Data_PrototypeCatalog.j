        set ProtoEventKey[86] = "axel_request"
        set ProtoEventName[86] = "게시판의 밀린 의뢰"
        set ProtoEventHead[86] = 2
        set ProtoEventKind[86] = 1
        set ProtoEventChoices[86] = 3
        set ProtoEventAPCost[86] = 1
        set ProtoEventMainStage[86] = 0
        set ProtoEventEpilogue[86] = 0
        set ProtoEventGrade[86] = 1
        set ProtoEventStory[86] = "루나가 손님이 몰리는 시간에 의뢰서를 놓쳤다. 약한 몬스터 무리가 방치된 길과 강한 몬스터가 남은 길을 모두 정리해야 하지만, 한 사람이 두 곳을 맡기는 어렵다. 카즈마는 보수가 큰 쪽을, 다크니스는 맞아 줄 일이 많은 쪽을 가리킨다."
        set ProtoEventIntro[86] = "길드 의뢰 두 개가 겹쳤다. 어느 쪽을 맡을까?"
        set ProtoEventIcon[86] = "ReplaceableTextures\\CommandButtons\\BTNChestOfGold.blp"
        set ProtoEventRequired[86] = 0
        set ProtoEventRequiredChoice[86] = 0
        set ProtoEventRequiredCard[86] = 0
