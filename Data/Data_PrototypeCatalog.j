        set ProtoEventFailure[230] = ""
        set ProtoEventDialogueEnabled[230] = 1
        set ProtoEventCommonResult[230] = "클라인은 친구들을 버릴 수 없어 남기로 한다. |cFF006B8F키리토|r는 자신의 지식만으로 그들 모두를 지킬 자신이 없어 혼자 떠난다. 두 사람은 서로 살아남기를 바라며 헤어진다. 앞서 나가는 길에는 동료를 두고 왔다는 부담도 남는다."
        set ProtoEventDialogueFirst[230] = 0
        set ProtoBranchLabel[920] = "|cFF006B8F키리토|r · “함께 다음 마을로 가자. 내가 아는 길이 있어.”"
        set ProtoBranchResult[920] = "클라인은 함께 접속한 친구들도 데려갈 수 있는지 묻는다. |cFF006B8F키리토|r는 모두를 지킬 수 있을지 쉽게 답하지 못한다."
        set ProtoBranchCard[920] = 383
