        set ProtoEventKey[378] = "hsr_main_03"
        set ProtoEventName[378] = "반디와 나란히 걷는 거리"
        set ProtoEventHead[378] = 10
        set ProtoEventKind[378] = 1
        set ProtoEventChoices[378] = 3
        set ProtoEventAPCost[378] = 1
        set ProtoEventMainStage[378] = 3
        set ProtoEventEpilogue[378] = 0
        set ProtoEventGrade[378] = 1
        set ProtoEventStory[378] = "반디는 관광객이 붐비는 길을 지나 자신이 좋아하는 장소를 알려 준다. 대단한 명소가 아니어도 함께 걸으면 다른 풍경이 된다. 사소한 취향을 이야기하는 동안, 꿈에서는 평범한 일상이 누군가에게 특별한 선물일 수 있음을 알게 된다. 반디의 모든 사정을 들은 것은 아니다. 서둘러 이름표를 붙이기보다, 지금 곁에서 웃는 사람의 말을 더 들어 보기로 한다."
        set ProtoEventIntro[378] = "광장에서 반디를 만난다. 누구의 안내를 따를지보다 함께 무엇을 보고 싶은지가 먼저 떠오른다."
        set ProtoEventIcon[378] = "ReplaceableTextures\\CommandButtons\\BTNTome.blp"
