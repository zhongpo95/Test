        set ProtoCardEnding[935] = 1
        set ProtoCardDescription[935] = "승객들은 살아 돌아왔고 |cFF006B8F렌고쿠|r는 돌아오지 못했다. 남겨진 사람들은 슬픔을 지우는 대신 그가 지켜 준 생명으로 다음 길을 준비한다."
