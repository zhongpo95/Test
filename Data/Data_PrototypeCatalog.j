        set ProtoEventDialogueFirst[109] = 7
        set ProtoDialogueStory[7] = "무기를 놓지 못한 |cFF006B8F카즈마|r는 겨울장군의 공격에 목숨을 잃고 사후 세계에서 여신 에리스를 만난다. 모험을 끝낼 기회가 생기지만 현세에서는 |cFF006B8F아쿠아|r의 소생 요청과 동료들의 부름이 들려온다.|n|n에리스 · 돌아가도 추위와 빚은 사라지지 않는다. 카즈마가 익숙한 동료들의 |cFF80560C목소리|r를 듣는다."
        set ProtoDialogueChoices[7] = 2
        set ProtoDialogueNext[7] = 0
