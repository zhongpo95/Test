        set ProtoEventFailure[238] = ""
        set ProtoEventDialogueEnabled[238] = 1
        set ProtoEventCommonResult[238] = "두 사람은 결혼하고 잠시 공략에서 물러나기로 한다. 죽음을 피하는 것만이 아니라 함께 식사하고 쉴 시간을 갖고 싶다. 전선에서 떨어진 이십이 층 호숫가에 둘의 작은 집을 마련한다."
        set ProtoEventDialogueFirst[238] = 27
        set ProtoDialogueStory[27] = "죽음이 가까웠던 순간을 지나 두 사람은 서로를 잃고 싶지 않다는 마음을 확인한다. |cFF006B8F키리토|r는 싸움이 없는 곳에서 함께 살아갈 시간을 이야기한다.|n|n키리토 · |cFF006B8F아스나|r와 함께할 내일을 말한다."
        set ProtoDialogueChoices[27] = 2
        set ProtoDialogueNext[27] = 0
        set ProtoDialogueLabel[108] = "“잠깐이라도 같이 쉬며 지내고 싶어.”"
        set ProtoDialogueResult[108] = "|cFF006B8F아스나|r는 자신도 그렇다고 답한다. 두 사람은 전선에서 떨어진 집과 함께 보낼 하루를 이야기한다."
