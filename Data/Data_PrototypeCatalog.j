        set ProtoEventGrade[287] = 1
        set ProtoEventStory[287] = "나츠와 운반 길을 열고 돌아오니 맡아 둔 목재를 어디에 쓸지 묻는 사람들이 있다. 그레이는 위험한 길목의 방어물을 만들려 하고, 웬디는 운반을 마친 사람들의 회복을 돕고 있다. 엘자는 더 약한 담당 구역을 고르더라도 검을 잡을 쪽은 비워 두자고 한다."
        set ProtoEventIntro[287] = "목재를 짊어지고 돌아온 일행들이 다음 행동을 결정하지 못해 멈춰 서 있다."
