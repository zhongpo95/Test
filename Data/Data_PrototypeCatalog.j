        set ProtoEventFailure[349] = ""
        set ProtoEventDialogueEnabled[349] = 1
        set ProtoEventCommonResult[349] = "|cFF006B8F이치고|r는 자기 의지로 |cFF006B8F뱌쿠야|r와 마지막 일격을 나눈다. 두 사람 모두 큰 상처를 입은 뒤 뱌쿠야가 패배를 인정한다. 그는 더는 |cFF006B8F루키아|r를 구하는 일을 막지 않겠다고 한다."
        set ProtoEventDialogueFirst[349] = 48
        set ProtoDialogueStory[48] = "|cFF006B8F이치고|r는 |cFF006B8F루키아|r를 죽이는 법이라면 싸우겠다는 뜻을 꺾지 않는다. 두 사람은 |cFF865500만해|r를 펼쳐 전력을 부딪친다. 이치고는 빠른 움직임으로 맞서지만, 누적된 상처와 |cFF006B8F뱌쿠야|r의 공격에 점점 몰린다. 그때 이치고 안의 호로가 나타나 뱌쿠야를 압박한다. 이치고는 스스로 그 개입을 억누른다.|n|n이치고 · 내 안의 힘이라고 아무렇게나 맡기지는 않겠어."
