        set ProtoEventKey[418] = "amestris_main_09"
        set ProtoEventName[418] = "돌아와서야 들은 휴즈의 죽음"
        set ProtoEventHead[418] = 11
        set ProtoEventKind[418] = 1
        set ProtoEventChoices[418] = 3
        set ProtoEventAPCost[418] = 1
        set ProtoEventMainStage[418] = 9
        set ProtoEventEpilogue[418] = 0
        set ProtoEventGrade[418] = 2
        set ProtoEventStory[418] = "센트럴로 돌아온 형제는 자신들의 조사를 도왔던 군인 휴즈가 |cFF704261이미 살해됐다는 소식|r을 듣는다. 그는 |cFF006B8F머스탱|r의 오랜 친구이며, 아내 그라시아와 어린 딸 엘리시아를 아끼던 아버지다. 돌의 연구와 군의 음모를 조사한 끝에 목숨을 잃었지만 형제는 떠나 있는 동안 그 사실을 몰랐다.|n|n|cFF006B8F알|r — 그동안 우리는 아무것도 모르고 있었어."
        set ProtoEventIntro[418] = "다시 만나리라 믿었던 휴즈는 이미 세상을 떠났다."
        set ProtoEventIcon[418] = "war3mapImported\\UI_EventThumb_Card_FMO1_hughes_Art.tga"
        set ProtoEventImageAspect[418] = 1.777778
        set ProtoEventRequired[418] = 0
        set ProtoEventRequiredChoice[418] = 0
        set ProtoEventRequiredCard[418] = 0
        set ProtoEventFailure[418] = ""
        set ProtoEventDialogueEnabled[418] = 1
        set ProtoEventCommonResult[418] = "다시 만날 수 있으리라 생각했던 사람의 집에는 기다리던 가족만 남아 있다. |cFF006B8F에드|r와 |cFF006B8F알|r은 자신들이 찾는 진실의 위험이 연구실 밖의 삶에도 닿았음을 절감한다. 친구를 잃은 |cFF006B8F머스탱|r 역시 범인을 찾으려 한다. 그 과정에서 군인 마리아 로스가 휴즈 살해범이라는 혐의를 받으며, 알려진 사건의 경위를 다시 살펴야 할 문제가 생긴다."
        set ProtoEventDialogueFirst[418] = 0
