        set ProtoEventRequiredCard[429] = 0
        set ProtoEventFailure[429] = ""
        set ProtoEventDialogueEnabled[429] = 1
        set ProtoEventCommonResult[429] = "|cFF006B8F린|r은 불사를 얻으려 |cFF865500현자의 돌|r을 받아들여 |cFF006B8F그리드|r와 한 몸을 쓰게 된다. 형제는 봉쇄되지 않은 다른 연금술과 |cFF006B8F스카|r의 형이 남긴 연구에서 돌파구를 찾으려 북방으로 향한다."
        set ProtoEventDialogueFirst[429] = 67
        set ProtoDialogueStory[67] = "그는 연금술을 봉쇄하면서도 형제가 인주로 필요하다며 살려 둔다. 브래들리 역시 호문쿨루스이고 군 수뇌부가 적과 한편이라는 사실이 드러난다. 군에 신고해 해결할 수 없으며 |cFF006B8F윈리|r 같은 주변 사람도 위협받는다.|n|n|cFF006B8F에드|r · 군에 알리는 것만으로는 해결되지 않겠어."
        set ProtoDialogueChoices[67] = 2
        set ProtoDialogueNext[67] = 0
