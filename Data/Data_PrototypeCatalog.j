        set ProtoEventDialogueEnabled[625] = 1
        set ProtoEventCommonResult[625] = "|cFF006B8F미카도|r와 |cFF006B8F안리|r, |cFF006B8F마사오미|r는 같은 학교의 일상을 나누기 시작한다. 그 밖의 거리에서는 다른 관계들이 계속 얽힌다."
        set ProtoEventDialogueFirst[625] = 0
        set ProtoBranchLabel[2500] = "|cFF006B8F안리|r에게 괜찮은지 먼저 묻는다"
        set ProtoBranchResult[2500] = "주변의 큰 |cFF80560C목소리|r보다 당사자의 반응부터 확인한다. |cFF006B8F안리|r는 짧게 답하며 고개를 든다."
