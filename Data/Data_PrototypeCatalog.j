        set ProtoEventKey[69] = "axel_request"
        set ProtoEventName[69] = "게시판의 밀린 의뢰"
        set ProtoEventHead[69] = 2
        set ProtoEventKind[69] = 1
        set ProtoEventChoices[69] = 3
        set ProtoEventAPCost[69] = 1
        set ProtoEventStory[69] = "루나가 손님이 몰리는 시간에 의뢰서를 놓쳤다. 약한 몬스터 무리가 방치된 길과 강한 몬스터가 남은 길을 모두 정리해야 하지만, 한 사람이 두 곳을 맡기는 어렵다. 카즈마는 보수가 큰 쪽을, 다크니스는 맞아 줄 일이 많은 쪽을 가리킨다."
        set ProtoEventIntro[69] = "길드 의뢰 두 개가 겹쳤다. 어느 쪽을 맡을까?"
        set ProtoEventIcon[69] = "ReplaceableTextures\\CommandButtons\\BTNChestOfGold.blp"
        set ProtoEventRequired[69] = 0
        set ProtoEventRequiredChoice[69] = 0
        set ProtoEventRequiredCard[69] = 0
        set ProtoEventFailure[69] = ""
        set ProtoBranchLabel[276] = "카즈마와 몬스터 무리를 맡는다"
        set ProtoBranchResult[276] = "카즈마와 몬스터 수가 많은 의뢰를 골랐다. 서류의 수고비부터 확인했지만, 약속된 자리에는 상대해야 할 무리도 더 기다리고 있었다."
        set ProtoBranchCard[276] = 37
        set ProtoBranchCard2[276] = 0
        set ProtoBranchGold[276] = 0
        set ProtoBranchCost[276] = 0
        set ProtoBranchLevel[276] = 0
        set ProtoBranchDensity[276] = 2
        set ProtoBranchPotions[276] = 0
        set ProtoBranchChance[276] = 100
        set ProtoBranchLabel[277] = "다크니스와 강한 몬스터를 맡는다"
        set ProtoBranchResult[277] = "다크니스와 강한 몬스터가 남은 의뢰를 맡았다. 그녀는 앞에서 버틸 자리를 반겼고, 당신은 빗나가는 검에 기대기보다 빈틈이 생길 때 움직일 위치를 골랐다. 돌아오는 길에도 강한 상대를 경계해야 한다."
        set ProtoBranchCard[277] = 40
        set ProtoBranchCard2[277] = 0
        set ProtoBranchGold[277] = 0
        set ProtoBranchCost[277] = 0
        set ProtoBranchLevel[277] = 1
        set ProtoBranchDensity[277] = 0
        set ProtoBranchPotions[277] = 0
        set ProtoBranchChance[277] = 100
        set ProtoBranchLabel[278] = "150골드로 운송을 준비하고 루나와 의뢰를 나눠 맡는다"
        set ProtoBranchResult[278] = "루나와 의뢰를 나눠 맡고 다른 모험가가 지나갈 운송 길부터 비웠다. 150골드를 지불했다. 「처음 온 사람의 다음 질문」의 기억 카드1장을 얻었다. 내 사냥의 적 수 단계를 최저1범위에서1낮췄다. 루나는 두 의뢰서를 다시 겹쳐 놓지 않고 네가 맡은 쪽 옆에 다음 질문을 적는다."
        set ProtoBranchCard[278] = 48
