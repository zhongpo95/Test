        set ProtoBranchCost[849] = 0
        set ProtoBranchLevel[849] = 1
        set ProtoBranchDensity[849] = 0
        set ProtoBranchPotions[849] = 0
        set ProtoBranchChance[849] = 100
        set ProtoBranchLabel[850] = "160골드로 분류 도구를 마련하고 리즈벳과 깨진 면을 나눠 본다"
        set ProtoBranchResult[850] = "160골드로 분류 도구를 마련하고 리즈벳과 깨진 면을 나눠 봤다. 리즈벳은 네가 나눈 파편을 쟁반에 펼쳤지만 아직 만들지 않은 |cFF80560C검|r의 값을 |cFF80560C약속|r하지 않았다."
