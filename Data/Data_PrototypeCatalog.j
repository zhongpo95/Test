        set ProtoEventDialogueFirst[78] = 3
        set ProtoDialogueStory[3] = "교회에 간 |cFF006B8F린|r은 |cFF006B8F아처|r까지 |cFF006B8F캐스터|r의 편으로 돌아서는 것을 본다. |cFF006B8F세이버|r뿐 아니라 자신의 영령도 잃어 이제 두 사람만으로 정면 대결하기 어렵다.|n|n린 · 린은 다른 참가자에게 도움을 청할 방법을 찾는다."
        set ProtoDialogueChoices[3] = 2
