        set ProtoEventCommonResult[624] = "|cFF006B8F미카도|r의 새 생활이 시작된다. 거리에서 들은 이름들은 곧 그의 일상과 직접 맞닿게 된다."
        set ProtoEventDialogueFirst[624] = 0
        set ProtoBranchLabel[2496] = "거리의 움직임을 직접 살핀다"
