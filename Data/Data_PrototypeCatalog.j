        set ProtoEventRequiredCard[430] = 0
        set ProtoEventFailure[430] = ""
        set ProtoEventDialogueEnabled[430] = 1
        set ProtoEventCommonResult[430] = "|cFF006B8F호엔하임|r은 긴 세월 같은 희생이 반복되지 않도록 대비해 왔다. 아메스트리스에서 벌어질 일을 돌이킬 준비가, 이미 한 나라를 잃은 그의 과거와 이어진다."
        set ProtoEventDialogueFirst[430] = 68
        set ProtoDialogueStory[68] = "그 존재는 왕국 전체를 연성해 국민들의 혼을 빼앗고, |cFF006B8F호엔하임|r과 닮은 육체를 얻었다. 호엔하임 역시 수많은 혼을 품은 불사의 몸이 된다. 두 존재가 닮은 육체와 불멸의 시간을 얻은 배경에는 나라 하나의 희생이 있었다.|n|n호엔하임 · 같은 희생을 다시 보고만 있을 수는 없다."
        set ProtoDialogueChoices[68] = 2
        set ProtoDialogueNext[68] = 0
        set ProtoDialogueLabel[272] = "동행자 · 그 준비에 우리도 힘을 보탤게요."
        set ProtoDialogueResult[272] = "|cFF006B8F호엔하임|r은 각자의 자리에서 버텨 줄 사람이 필요하다며 받아들인다."
        set ProtoDialogueLabel[273] = "동행자 · 국민을 되돌릴 때를 놓치지 맙시다."
        set ProtoDialogueResult[273] = "|cFF006B8F호엔하임|r은 아직 되돌릴 순간을 놓치지 않기 위해 준비한 것이라며 답한다."
