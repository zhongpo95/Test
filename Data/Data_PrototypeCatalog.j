        set ProtoEventFailure[377] = ""
        set ProtoEventDialogueEnabled[377] = 1
        set ProtoEventCommonResult[377] = "|cFF006B8F미샤|r는 객실의 입몽 장치로 잠들면 |cFF80560C꿈|r의 |cFF80560C도시|r를 방문할 수 있다고 설명한다. 안내를 마친 소년과 인사를 나누고, 당신은 장치에 몸을 맡긴다. 눈을 뜨자 호텔 대신 황금빛 거리와 축제의 소음이 펼쳐진다. 페나코니에서의 첫 산책이 시작된다."
        set ProtoEventDialogueFirst[377] = 0
        set ProtoBranchLabel[1508] = "“처음 왔는데, 좀 도와줄래?”"
