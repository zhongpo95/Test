        set ProtoEventRequiredCard[212] = 0
        set ProtoEventFailure[212] = ""
        set ProtoBranchLabel[848] = "220골드로 수송 준비를 마련하며 리즈벳의 가공을 지켜본다"
        set ProtoBranchResult[848] = "220골드로 수송 준비를 마련하며 리즈벳의 가공을 지켜봤다. 리즈벳은 부러진 검보다 새 재료를 둘 공간을 먼저 가리켰다."
        set ProtoBranchCard[848] = 360
        set ProtoBranchCard2[848] = 0
        set ProtoBranchGold[848] = 0
        set ProtoBranchCost[848] = 220
        set ProtoBranchLevel[848] = 0
        set ProtoBranchDensity[848] = 0
        set ProtoBranchPotions[848] = 0
        set ProtoBranchChance[848] = 100
        set ProtoBranchLabel[849] = "더 강한 개인 사냥을 맡으며 |cFF006B8F키리토|r의 움직임을 기억한다"
        set ProtoBranchResult[849] = "더 강한 개인 사냥을 맡으며 |cFF006B8F키리토|r의 움직임을 |cFF80560C기억|r했다. 내 개인 사냥의 적 강함 단계가 1 늘었다. 키리토는 비교할 때 썼던 손을 거두고 파편의 처리는 리즈벳에게 남겼다."
        set ProtoBranchCard[849] = 358
