        set ProtoEventFailure[199] = ""
        set ProtoEventDialogueEnabled[199] = 1
        set ProtoEventCommonResult[199] = "살아 나온 |cFF006B8F마도카|r에게는 |cFF006B8F마미|r가 내일을 말하던 얼굴이 남는다. 강한 선배조차 죽을 수 있는 싸움이었다. 소원을 얻을 기대만으로 마법소녀가 되겠다고 말할 수 없게 된 두 친구는 무거운 마음으로 일상에 돌아간다."
        set ProtoEventDialogueFirst[199] = 18
        set ProtoDialogueStory[18] = "|cFF006B8F마미|r는 다시 용기를 얻어 싸우지만 마녀의 변신을 예상하지 못해 목숨을 잃는다. 풀려난 |cFF006B8F호무라|r가 남은 마녀를 쓰러뜨려 |cFF006B8F마도카|r와 |cFF006B8F사야카|r를 구한다. 조금 전 함께 이야기하던 선배가 더는 돌아오지 않는다.|n|n마도카 · 호무라가 서 있는 곳에서 쉽게 발을 떼지 못한다."
        set ProtoDialogueChoices[18] = 2
        set ProtoDialogueNext[18] = 0
        set ProtoDialogueLabel[72] = "“선배와 방금 |cFF80560C약속|r했는데….”"
        set ProtoDialogueResult[72] = "|cFF006B8F호무라|r는 |cFF006B8F마도카|r의 말을 듣는다. 마도카는 대답을 기다리면서도 선배가 돌아오지 않는다는 사실을 받아들이지 못한다."
        set ProtoDialogueLabel[73] = "사야카의 손을 잡고 |cFF006B8F호무라|r를 따라 밖으로 나온다."
        set ProtoDialogueResult[73] = "|cFF006B8F사야카|r도 손을 놓지 않는다. 두 친구는 서로를 의지한 채 결계가 있던 곳에서 물러난다."
