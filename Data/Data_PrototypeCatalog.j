        set ProtoDialogueResult[532] = "|cFF006B8F히로|r는 하나의 답이 여러 사람을 지나왔다는 사실을 잊지 않는다."
        set ProtoDialogueLabel[533] = "이번에 물어야 할 질문을 고른다."
